# Dependencies
node_modules/
.pnp
.pnp.js

# Python bytecode (verdict evaluator + its test)
__pycache__/
*.pyc

# Build output
dist/
dist-admin/
build/
*.tsbuildinfo

# Generated: shared metrics module staged into the standalone ha-broker build (make stage-shared)
/ha-broker/src/metrics.ts

# Env / secrets (never commit)
.env
.env.*
!.env.example

# Playwright
/test-results/
/playwright-report/
/blob-report/
/.playwright-mcp/
/playwright/.cache/

# Caddy runtime data (certs, account keys): persisted via docker volumes, not git
/infra/caddy_data/
/infra/caddy_config/

# Wildcard cert + key written by acme.sh (host), bind-mounted read-only into Caddy
/infra/certs/

# Guest email allowlist (real Google addresses): never commit; template is emails.txt.example
/infra/oauth2-proxy/emails.txt

# Generated container-health file (written by the status cron), plus its temp files
/infra/status/status.json
/infra/status/.status.*

# Generated metrics: textfile-collector .prom output (written by host collectors) + temp files.
/infra/metrics/textfile/*.prom
/infra/metrics/textfile/.*.prom.*

# Verdict + public-dot files the host evaluator (write-verdict.py) writes into the api ./status
# mount. Runtime artifacts, not source.
/infra/status/verdict.json
/infra/status/health-dot.json
/infra/status/*.tmp

# Access audit (§6): the raw Caddy access log (holds request headers + identities), the curated
# append-only store the api serves, and the processor's offset state. Never commit — real
# identities/IPs. Restricted, host-only.
/infra/audit/caddy/*.log
/infra/audit/.audit-offset*
/infra/status/access.jsonl
/infra/status/.access.*

# Logs / OS / editor
*.log
npm-debug.log*
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Local operational notes with real infra addresses: never commit
PROJECT_STATUS.md
