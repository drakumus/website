# Copy to infra/.env (gitignored) and fill in. Used by docker-compose for Caddy ACME.
ACME_EMAIL=you@example.com

# --- secure access (Phase 8; see ~/specs/secure-access.md §8 + secure-access-setup.md) ---
# Real values live only in infra/.env (gitignored), never here.
HOME_TS_IP=                    # home tailnet IPv4 (`tailscale ip -4`); CoreDNS + split-DNS target
HA_ADDR=                       # Home Assistant LAN address, e.g. <HA_LAN_IP>:8123
HA_TOKEN=                      # long-lived token for the NON-admin HA user (ha-broker only)
GOOGLE_CLIENT_ID=              # oauth2-proxy (guest login)
GOOGLE_CLIENT_SECRET=          # oauth2-proxy
OAUTH2_PROXY_COOKIE_SECRET=    # oauth2-proxy; `openssl rand -base64 32`
# ADMIN_ADDR / FINANCE_ADDR — leave unset; Caddy serves placeholder responders until built
# DO_TOKEN is NOT here — it's a host-only file (~/.secrets/dns_token), read by acme.sh

