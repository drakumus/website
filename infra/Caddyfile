# ============================================================================================
# CUTOVER Caddyfile (secure-access.md Stage 6). NOT LIVE until swapped in for ./Caddyfile at
# the cutover. Changes vs the current live config:
#   - auto_https OFF; every vhost loads the acme.sh wildcard from /certs (no inbound ACME).
#   - PORT-SPLIT: public vhosts on :8443 (VPS forwards :443 -> home:8443), private on :443.
#   - Explicit port-less :80 -> HTTPS redirect (Caddy's auto one would leak :8443).
#   - New private vhosts (admin/ha/finance, tailnet-only) and the guest OAuth surface.
#
# Requires (applied at cutover, see setup checklist Part B):
#   - compose `caddy`: container_name: caddy · env HA_ADDR · mount ./certs:/certs:ro
#   - VPS forwarder :443 -> home:8443 · Tailscale tag ACL · home firewall · guest public DNS
# ============================================================================================

{
	# All certs come from the wildcard file below; Caddy's own ACME is disabled.
	auto_https off
}

# ---- snippets ----
(sec) {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

(wildcard_tls) {
	tls /certs/zoci.me.crt /certs/zoci.me.key
}

# Drop any client-supplied X-Auth-Request-*; the trusted copy is set ONLY by forward_auth on
# guest (§7.2). Imported by every internet-facing vhost so the shared `api` can't be spoofed.
(strip_auth_headers) {
	request_header -X-Auth-Request-Email
	request_header -X-Auth-Request-User
	request_header -X-Auth-Request-Groups
	request_header -X-Auth-Request-Preferred-Username
	request_header -X-Auth-Request-Access-Token
}

# Fail-closed backstop for private vhosts (§7.1): 404 anything not from the tailnet, AND the
# VPS itself. The VPS is a tailnet peer (so it's inside 100.64.0.0/10), and the Tailscale ACL
# blocking VPS->:443 is the real boundary, but that ACL is invisible here, so this backstop
# now also 404s the VPS's tailnet IP ({$VPS_TS_IP} from infra/.env) to genuinely cover it.
# Use inside a `route {}` so it deterministically precedes the vhost's own handler.
(tailnet_guard) {
	@offnet not remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
	@vps remote_ip {$VPS_TS_IP}
	respond @offnet 404
	respond @vps 404
}

# Access audit (§6): JSON access log for the private + guest vhosts, rolled on the host. A host-side
# processor enriches each line (tailscale whois -> device for the private vhosts, the oauth2 email
# for guest) into the append-only audit store. The raw log carries request headers, so it is
# host-only, gitignored, and restricted (never static-served, never publicly reachable).
(audit_log) {
	log {
		output file /var/log/caddy/audit.log {
			roll_size 10MiB
			roll_keep 5
			mode 644
		}
		format json
	}
}

# ---- HTTP -> HTTPS (port-less; works for public :443->VPS->:8443 and private :443 direct) ----
:80 {
	redir https://{host}{uri} permanent
}

# ================= PUBLIC (served on :8443; VPS forwards :443 -> home:8443) =================
zoci.me:8443 {
	import sec
	import strip_auth_headers
	import wildcard_tls
	encode zstd gzip
	handle_path /api/* {
		reverse_proxy localhost:8000
	}
	reverse_proxy localhost:8080
}

www.zoci.me:8443 {
	import sec
	import wildcard_tls
	redir https://zoci.me{uri} permanent
}

js1.zoci.me:8443 {
	import sec
	import strip_auth_headers
	import wildcard_tls
	reverse_proxy localhost:8096
}

guest.zoci.me:8443 {
	import sec
	import wildcard_tls
	import audit_log
	encode zstd gzip

	handle /oauth2/* {              # oauth2-proxy endpoints must BYPASS the auth check
		reverse_proxy localhost:4180
	}
	handle {                        # everything else needs an allowlisted Google identity
		route {                     # strip client-set headers BEFORE forward_auth sets the trusted one
			import strip_auth_headers
			# 2xx -> copy the identity header and fall through to the api; 401 -> redirect the
			# browser into the Google flow (per oauth2-proxy's official Caddy integration doc).
			forward_auth localhost:4180 {
				uri /oauth2/auth
				copy_headers X-Auth-Request-Email
				@error status 401
				handle_response @error {
					redir * /oauth2/sign_in?rd={scheme}://{host}{uri}
				}
			}
			rewrite * /guest{uri}   # api guest routes live under /guest/*
			reverse_proxy localhost:8000
		}
	}
}

# ================= PRIVATE (tailnet-only; served on :443) =================
admin.zoci.me {
	import sec
	import strip_auth_headers
	import wildcard_tls
	import audit_log
	route {
		import tailnet_guard
		# Embedded Grafana: serves under /grafana (serve_from_sub_path), so pass the prefix through.
		# frame-ancestors 'self' lets the same-origin admin page iframe it, nothing else.
		handle /grafana/* {
			header Content-Security-Policy "frame-ancestors 'self'"
			reverse_proxy 127.0.0.1:3000
		}
		# Admin data API (verdict, etc.): the api admin listener, tailnet-only. Strip /api like the
		# public vhost so the listener sees /verdict. The full verdict is never on the public :8000.
		handle_path /api/* {
			reverse_proxy 127.0.0.1:9102
		}
		# The React/Mantine admin UI (admin-web).
		handle {
			reverse_proxy 127.0.0.1:8090
		}
	}
}

drop.zoci.me {
	import sec
	import wildcard_tls
	import audit_log
	route {
		import tailnet_guard
		# Agent deliverables previewer (the drop container). Read-only file serving; content
		# arrives via host-side file writes. The single POST route is the opened-history.
		reverse_proxy 127.0.0.1:8092
	}
}

ha.zoci.me {
	import sec
	import wildcard_tls
	import audit_log
	route {
		import tailnet_guard
		reverse_proxy {$HA_ADDR:127.0.0.1:9}
	}
}

finance.zoci.me {
	import sec
	import wildcard_tls
	import audit_log
	route {
		import tailnet_guard
		# Finance data API: the finance backend's loopback listener, tailnet-only. Strip /api like the
		# public + admin vhosts so the listener sees /status, /sync, /link/*. The Plaid credentials and
		# financial data live only behind this, never on the public :8000.
		handle_path /api/* {
			reverse_proxy 127.0.0.1:9103
		}
		# The React/Mantine finance UI (finance-web).
		handle {
			reverse_proxy 127.0.0.1:8091
		}
	}
}
