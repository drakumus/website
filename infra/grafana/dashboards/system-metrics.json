    {
      "id": 117,
      "type": "table",
      "title": "Restarts & uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "uptime",
          "instant": true,
          "format": "table",
          "editorMode": "code",
          "expr": "max by (container) (time() - zoci_container_start_time_seconds{container=~\"infra-victoria-metrics-1|infra-node-exporter-1|infra-grafana-1\"})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "restarts",
          "instant": true,
          "format": "table",
          "editorMode": "code",
          "expr": "max by (container) (zoci_container_restart_count{container=~\"infra-victoria-metrics-1|infra-node-exporter-1|infra-grafana-1\"})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "exit",
          "instant": true,
          "format": "table",
          "editorMode": "code",
          "expr": "max by (container) (zoci_container_last_exit_code{container=~\"infra-victoria-metrics-1|infra-node-exporter-1|infra-grafana-1\"})"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "container",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(container|Value.*)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "container": "Container",
              "Value #uptime": "Uptime",
              "Value #restarts": "Restarts",
              "Value #exit": "Exit code"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Restarts"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 5
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Restarts",
            "desc": true
          }
        ]
      }
    },
