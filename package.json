{
  "name": "zoci-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "app",
    "api"
  ],
  "scripts": {
    "dev": "concurrently -n app,api,broker -c blue,green,magenta \"npm:dev:app\" \"npm:dev:api\" \"npm:dev:broker\"",
    "dev:app": "npm run dev --workspace app",
    "dev:api": "GUEST_DEV=1 BROKER_URL=http://localhost:8081 npm run dev --workspace api",
    "dev:broker": "GUEST_DEV=1 PORT=8081 npm --prefix ha-broker run dev",
    "build": "npm run build --workspace app",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "concurrently": "^9.1.0"
  }
}
